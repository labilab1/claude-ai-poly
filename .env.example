# Copy this file to .env and fill in your real values.
# NEVER commit .env, and never paste these values into a chat.
# Only the two credentials are required; everything else has a default.

# ===========================================================================
# Credentials (required)
# ===========================================================================

# The private key of the wallet that SIGNS orders (your EOA / MetaMask key).
# API credentials are derived from it automatically on every run.
POLYMARKET_PRIVATE_KEY=

# Your Polymarket DEPOSIT (proxy) wallet address - the address that actually
# holds your USDC balance on Polymarket.
#
# READ THIS: if you log into Polymarket with a browser wallet, this is usually
# NOT your MetaMask account address. Polymarket creates a separate proxy/Safe
# contract wallet that your key controls, and that is where the money lives.
# Putting the MetaMask address here still authenticates, then reports a $0
# balance with no error - which is a long, confusing debugging session.
# Find it on polymarket.com -> Deposit (or Settings); it starts with 0x.
# `python -m polymarket_bot.scripts.wallet_status` prints the signer address
# and this address side by side so you can compare them.
POLYMARKET_WALLET=

# ===========================================================================
# Risk limits (defaults shown; all in USDC)
# ===========================================================================

# Hard ceiling on any single order. Above this, trading.py records a BLOCKER
# and refuses to send - no confirmation flag overrides it. It applies to sells
# too, measured on estimated proceeds.
POLYMARKET_MAX_ORDER_USDC=5

# Max total cost basis allowed in one market (both outcomes combined).
POLYMARKET_MAX_POSITION_USDC=10

# Rolling 24h budget for realized losses booked BY THE MONITOR. Once it is
# spent the monitor keeps watching and reporting but stops selling, and says
# why. Losses you take by hand on the website are invisible to this budget.
# Set to 0 to disable the check.
POLYMARKET_DAILY_LOSS_LIMIT_USDC=10

# Cash buffer that must survive any buy: a buy is blocked if it would spend
# below this. 0 means "spend down to the last cent".
POLYMARKET_MIN_CASH_RESERVE_USDC=0

# ===========================================================================
# Monitor (the polling loop that makes stop-losses possible at all)
# ===========================================================================

# Seconds between sweeps when the monitor runs continuously.
POLYMARKET_MONITOR_INTERVAL_SECONDS=60

# true  = evaluate rules and report triggers, send nothing (the safe default)
# false = a triggered rule sends a real SELL order
# Truthy values: 1 / true / yes / on. Anything else counts as false.
POLYMARKET_MONITOR_DRY_RUN=true

# ===========================================================================
# Storage
# ===========================================================================

# Where exit_rules.json and monitor_state.json (the loss ledger) are written.
# Defaults to <repo>/data, which is git-ignored. Purely local state - none of
# it is known to Polymarket.
POLYMARKET_DATA_DIR=

# ===========================================================================
# Telegram (python -m polymarket_bot.scripts.telegram_bot)
# ===========================================================================

# Token from @BotFather on Telegram (create a bot, it gives you this).
TELEGRAM_BOT_TOKEN=

# Locks the bot to ONE chat - every other chat is silently ignored, even if it
# knows the bot exists. Leave this blank on first run: start the bot, message
# it anything, and it replies with your chat id to paste in here. Restart
# after setting it.
TELEGRAM_CHAT_ID=
