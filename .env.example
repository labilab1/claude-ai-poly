# Copy this file to .env and fill in your real values.
# NEVER commit .env, and never paste these values into chat.

# Polymarket CLOB REST endpoint
POLYMARKET_HOST=https://clob.polymarket.com

# Polygon mainnet chain id (Polymarket runs on Polygon)
POLYMARKET_CHAIN_ID=137

# Your wallet private key, used to sign orders. Keep this secret.
POLYMARKET_PRIVATE_KEY=

# CLOB API credentials (the 3 values Polymarket gave you)
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
