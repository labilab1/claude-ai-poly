# The monitor: the ONLY thing that enforces stop-losses.
#
# Polymarket has no native stop orders. A stop-loss or trailing stop exists
# solely inside this process - while it is not running, those rules protect
# nothing. That is the entire reason for putting the bot on a server.
#
# Install:  sudo cp deploy/polymarket-monitor.service /etc/systemd/system/
#           sudo systemctl daemon-reload
#           sudo systemctl enable --now polymarket-monitor
# Logs:     journalctl -u polymarket-monitor -f
#
# ---------------------------------------------------------------------------
# IT STARTS IN DRY RUN. READ THIS BEFORE CHANGING THAT.
# ---------------------------------------------------------------------------
# As shipped, ExecStart has no --execute: rules are evaluated and reported, and
# nothing is ever sold. That is deliberate - the first thing you want from a
# new deployment is to watch it decide correctly for a few days.
#
# To let it actually sell when a rule fires, add `--execute --yes` to ExecStart
# below, then `sudo systemctl daemon-reload && sudo systemctl restart
# polymarket-monitor`. --yes is required because there is no terminal here to
# type a confirmation into; the caps in .env (per-order, per-market, daily loss)
# are what bound it after that.

[Unit]
Description=Polymarket exit-rule monitor
Documentation=https://github.com/labilab1/claude-ai-poly
After=network-online.target
Wants=network-online.target
# Crash-loop guard. These belong in [Unit]: systemd moved them out of
# [Service] in v230, and left there they are silently ignored.
StartLimitBurst=5
StartLimitIntervalSec=600

[Service]
Type=simple
User=polymarket
Group=polymarket
WorkingDirectory=/opt/polymarket
# DRY RUN. Append `--execute --yes` to arm it - see the note above.
ExecStart=/opt/polymarket/venv/bin/python -m polymarket_bot.scripts.monitor

Restart=always
RestartSec=30

Environment=PYTHONUNBUFFERED=1
# ProtectSystem=strict makes the tree read-only, so bytecode caching
# would fail on every import. Disable it rather than retry it.
Environment=PYTHONDONTWRITEBYTECODE=1
StandardOutput=journal
StandardError=journal
SyslogIdentifier=polymarket-monitor

# --- hardening ---------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/opt/polymarket/data
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
